# Database Configuration
# Optional: set DB_CONNECTION to use an external PostgreSQL instance or cluster.
# When left unset, docker-compose.yml uses the bundled postgres service.
# Example:
# DB_CONNECTION=postgres://cpab:change-this-password@db.example.com:5432/cpab?sslmode=disable
POSTGRES_USER=cpab
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=cpab

# Application Configuration
JWT_SECRET=change-this-secret-string
JWT_EXPIRY=720h
